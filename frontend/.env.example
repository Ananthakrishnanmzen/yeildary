# Base URL of the Django API, including the /api prefix.
# Local development (vite.config.ts proxies /api to http://127.0.0.1:8000):
VITE_API_BASE_URL=http://localhost:8000/api

# Deployed example (see .env.production):
# VITE_API_BASE_URL=https://yieldary-backend.onrender.com/api

# Optional: Gemini API key for frontend-side calls. Never put secret keys in
# frontend variables - anything prefixed with VITE_ is visible in the bundle.
# GEMINI_API_KEY=
