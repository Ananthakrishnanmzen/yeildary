# Base URL of the Django API, including the /api prefix.
#
# Local development: keep this relative. Vite proxies /api (and the Django pages
# linked from the app) to http://127.0.0.1:8000, so requests are same-origin and
# there is no CORS, port or tunnel configuration to get wrong.
VITE_API_BASE_URL=/api

# Absolute alternative (only if the Django CORS settings allow this origin):
# VITE_API_BASE_URL=http://localhost:8000/api

# Deployed value (see .env.production):
# VITE_API_BASE_URL=https://yeildary.onrender.com/api

# Optional: Gemini API key for frontend-side calls. Never put secret keys in
# frontend variables - anything prefixed with VITE_ is visible in the bundle.
# GEMINI_API_KEY=
