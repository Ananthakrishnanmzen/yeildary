# Production API endpoint: the Django backend hosted on Render.
# This value is bundled into the browser build, so it must be an https origin
# that the backend trusts (see FRONTEND_URL in backend/config/settings.py).
# Override it with VITE_API_BASE_URL in the Vercel project settings if the
# backend URL ever changes. Never put secrets here.
VITE_API_BASE_URL=https://yeildary.onrender.com/api
